<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_app">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Header -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:background="@drawable/header_color_default"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="-20dp"

                android:background="@drawable/boton_menu_background"

                android:padding="8dp"

                android:scaleType="fitCenter"

                android:src="@drawable/icono_menu"

                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SERVICIO: XXX-XXXXX"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="italic"

                app:layout_constraintStart_toEndOf="@id/btnMenu"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="-15dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- CONTENIDO -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintTop_toBottomOf="@id/header"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="20dp">

                <!-- ESTADO -->
                <TextView
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:background="#42C86A"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="ENTREGADO"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <!-- INFORMACION -->
                <TextView
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Información del pedido :"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Origen : TRUJILLO"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:text="Destino : CAJAMARCA"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:text="Bultos : 1"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:text="Teléfono :"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:text="Destinatario : HANDSE DAT CAJAMARCA"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:text="Dirección :"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:text="Referencia :"
                    android:textColor="#FFFFFF"/>

                <!-- SEGUIMIENTO -->
                <TextView
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:text="Seguimiento detallado:"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <!-- RECEPCION -->
                <LinearLayout
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#2D2D2D"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recepción : 02/09/2026"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OFICINA TRUJILLO"
                        android:textColor="#FFFFFF"/>

                </LinearLayout>

                <!-- DESPACHO -->
                <LinearLayout
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:background="#2D2D2D"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Despacho : 02/09/2026"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DESTINO : CAJAMARCA"
                        android:textColor="#FFFFFF"/>

                </LinearLayout>

                <!-- ENTREGADO -->
                <LinearLayout
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:background="#2D2D2D"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Entregado : 03/09/2026"
                        android:textColor="#42C86A"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CONFIRMADO MEDIANTE IMAGEN"
                        android:textColor="#FFFFFF"/>

                </LinearLayout>

                <!-- BOTON -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNuevaBusqueda"
                    android:layout_width="250dp"
                    android:layout_height="70dp"
                    android:layout_marginTop="35dp"
                    android:layout_marginBottom="40dp"
                    android:text="NUEVA BÚSQUEDA"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    app:backgroundTint="#4a5cc3"
                    app:cornerRadius="15dp"/>

            </LinearLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- MENÚ LATERAL -->
    <LinearLayout
        android:id="@+id/menuLateral"
        android:layout_width="280dp"
        android:layout_height="460dp"
        android:layout_gravity="start"
        android:layout_marginTop="100dp"
        android:background="@drawable/menu_background"
        android:orientation="vertical"
        android:paddingTop="20dp">

        <!-- CONSULTAR -->
        <LinearLayout
            android:id="@+id/opConsultar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/menu_item_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/icono_consultar_menu_movil"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Consultar"
                android:textColor="#FFFFFF"
                android:textSize="25sp"/>
        </LinearLayout>

        <!-- REGISTRAR -->
        <LinearLayout
            android:id="@+id/opRegistrar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/menu_item_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/icono_registrar_menu_movil"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Registrar"
                android:textColor="#FFFFFF"
                android:textSize="25sp"/>
        </LinearLayout>

        <!-- RECOJO -->
        <LinearLayout
            android:id="@+id/opRecojo"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/menu_item_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/icono_recojo_menu_movil"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Recojo"
                android:textColor="#FFFFFF"
                android:textSize="25sp"/>
        </LinearLayout>

        <!-- ENTREGA -->
        <LinearLayout
            android:id="@+id/opEntrega"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/menu_item_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/icono_entrega_menu_movil"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Entrega"
                android:textColor="#FFFFFF"
                android:textSize="25sp"/>
        </LinearLayout>

        <!-- REZAGO -->
        <LinearLayout
            android:id="@+id/opRezago"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/menu_item_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/icono_rezago_menu_movil"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Rezago"
                android:textColor="#FFFFFF"
                android:textSize="25sp"/>
        </LinearLayout>

        <!-- RUTA DIA -->
        <LinearLayout
            android:id="@+id/opRutaDia"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/menu_item_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/icono_ruta_menu_movil"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Ruta Dia"
                android:textColor="#FFFFFF"
                android:textSize="25sp"/>
        </LinearLayout>

        <!-- Salir -->
        <LinearLayout
            android:id="@+id/opSalir"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/menu_item_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/icono_salir_menu_movil"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Salir"
                android:textColor="#FFFFFF"
                android:textSize="25sp"/>
        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>