<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Imagen ampliada -->
    <ImageView
        android:id="@+id/imgCompleta"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:contentDescription="Imagen ampliada" />

    <!-- Botón para rotar la imagen -->
    <ImageButton
        android:id="@+id/btnRotar"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="30dp"
        android:background="@drawable/header_color_default"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/girar"
        android:contentDescription="Rotar imagen" />

    <!-- Botón para salir -->
    <ImageButton
        android:id="@+id/btnSalir"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="@android:color/transparent"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/salir"
        android:contentDescription="Salir" />

</FrameLayout>
