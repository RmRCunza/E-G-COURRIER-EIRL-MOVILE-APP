<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_app">

    <!-- CONTENIDO PRINCIPAL -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Header -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:background="@drawable/header_color_default"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="-20dp"

                android:background="@drawable/boton_menu_background"

                android:padding="8dp"

                android:scaleType="fitCenter"

                android:src="@drawable/icono_menu"

                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REGISTRAR SERVICIO"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="italic"

                app:layout_constraintStart_toEndOf="@id/btnMenu"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="-15dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- FORMULARIO -->

        <ScrollView
            android:id="@+id/scrollFormulario"
            android:layout_width="0dp"
            android:layout_height="0dp"

            app:layout_constraintTop_toBottomOf="@id/header"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DATOS DE ORIGEN"
                    android:textColor="#000"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <!-- FECHA -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="Fecha"
                    android:textColor="#000"/>

                <TextView
                    android:id="@+id/tvFecha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:textColor="#000"
                    android:textSize="16sp"/>

                <!-- DOC -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Doc."
                    android:textColor="#000"/>

                <EditText
                    android:id="@+id/etDoc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="DNI"
                    android:textColorHint="#909191"/>/>

                <!-- CLIENTE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Cliente"
                    android:textColor="#000"/>

                <EditText
                    android:id="@+id/etCliente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nombre del cliente"
                    android:textColorHint="#909191"/>/>

                <!-- CLI SERIE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Cli. Serie"
                    android:textColor="#000"/>

                <EditText
                    android:id="@+id/etCliSerie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Serie cliente"
                    android:textColorHint="#909191"/>/>

                <!-- CLI GUIA -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Cli. Guía"
                    android:textColor="#000"/>

                <EditText
                    android:id="@+id/etCliGuia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Guía cliente"
                    android:textColorHint="#909191"/>/>

                <!-- CLI GRR HIJAS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Cli. GRR Hijas"
                    android:textColor="#000"/>

                <EditText
                    android:id="@+id/etCliGRRHijas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="GRR Hijas"
                    android:textColorHint="#909191"/>/>

                <!-- CLI SERVICIO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Cli. Serv."
                    android:textColor="#000"/>

                <EditText
                    android:id="@+id/etCliServ"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Servicio cliente"
                    android:textColorHint="#909191"/>/>

                <!-- DIRECCIÓN -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Dirección"
                    android:textColor="#000"/>

                <EditText
                    android:id="@+id/etDireccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Dirección"/>

                <!-- DEPARTAMENTO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Departamento"
                    android:textColor="#000"/>

                <Spinner
                    android:id="@+id/spDepartamento"
                    android:background="#b3b3b3"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"/>

                <!-- PROVINCIA -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Provincia"
                    android:textColor="#000"/>

                <Spinner
                    android:id="@+id/spProvincia"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"/>/>

                <!-- DISTRITO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Distrito"
                    android:textColor="#000"/>

                <Spinner
                    android:id="@+id/spDistrito"
                    android:background="#b3b3b3"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"/>

                <!-- BOTÓN SIGUIENTE -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSiguiente"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"

                    android:text="SIGUIENTE"
                    android:textColor="#FFFFFF"

                    app:backgroundTint="#4a5cc3"
                    app:cornerRadius="15dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="30dp"/>


            </LinearLayout>

        </ScrollView>



    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- MENÚ LATERAL -->
    <LinearLayout
        android:id="@+id/menuLateral"
        android:layout_width="280dp"
        android:layout_height="460dp"
        android:layout_gravity="start"
        android:layout_marginTop="100dp"
        android:background="@drawable/menu_background"
        android:orientation="vertical"
        android:paddingTop="20dp">

        <!-- CONSULTAR -->
        <LinearLayout
            android:id="@+id/opConsultar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/menu_item_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/icono_consultar_menu_movil"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Consultar"
                android:textColor="#FFFFFF"
                android:textSize="25sp"/>
        </LinearLayout>

        <!-- REGISTRAR -->
        <LinearLayout
            android:id="@+id/opRegistrar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/menu_item_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/icono_registrar_menu_movil"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Registrar"
                android:textColor="#FFFFFF"
                android:textSize="25sp"/>
        </LinearLayout>

        <!-- RECOJO -->
        <LinearLayout
            android:id="@+id/opRecojo"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/menu_item_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/icono_recojo_menu_movil"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Recojo"
                android:textColor="#FFFFFF"
                android:textSize="25sp"/>
        </LinearLayout>

        <!-- ENTREGA -->
        <LinearLayout
            android:id="@+id/opEntrega"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/menu_item_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/icono_entrega_menu_movil"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Entrega"
                android:textColor="#FFFFFF"
                android:textSize="25sp"/>
        </LinearLayout>

        <!-- REZAGO -->
        <LinearLayout
            android:id="@+id/opRezago"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/menu_item_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/icono_rezago_menu_movil"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Rezago"
                android:textColor="#FFFFFF"
                android:textSize="25sp"/>
        </LinearLayout>

        <!-- RUTA DIA -->
        <LinearLayout
            android:id="@+id/opRutaDia"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/menu_item_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/icono_ruta_menu_movil"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Ruta Dia"
                android:textColor="#FFFFFF"
                android:textSize="25sp"/>
        </LinearLayout>

        <!-- Salir -->
        <LinearLayout
            android:id="@+id/opSalir"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/menu_item_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/icono_salir_menu_movil"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Salir"
                android:textColor="#FFFFFF"
                android:textSize="25sp"/>
        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>